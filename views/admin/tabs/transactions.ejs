<div class="admin-page-head">
  <div>
    <span class="eyebrow">TRANSAKSI</span>
    <h2>Konfirmasi pembayaran manual.</h2>
    <p>Setujui transaksi setelah pembayaran diterima. Persetujuan akan mengaktifkan plan dan menambah kuota user secara otomatis.</p>
  </div>
  <div class="admin-page-actions">
    <a class="btn btn-ghost" href="/admin/transactions?status=pending"><i data-lucide="clock"></i> Pending</a>
    <a class="btn btn-ghost" href="/admin/transactions?status=approved"><i data-lucide="check-check"></i> Approved</a>
  </div>
</div>

<section class="admin-panel glass-card">
  <div class="panel-head">
    <div><span class="eyebrow">DAFTAR</span><h2>Transaksi</h2></div>
    <div class="chip-row">
      <a class="chip <%= !status ? 'is-active' : '' %>" href="/admin/transactions">Semua</a>
      <a class="chip <%= status === 'pending' ? 'is-active' : '' %>" href="/admin/transactions?status=pending">Pending</a>
      <a class="chip <%= status === 'approved' ? 'is-active' : '' %>" href="/admin/transactions?status=approved">Approved</a>
      <a class="chip <%= status === 'rejected' ? 'is-active' : '' %>" href="/admin/transactions?status=rejected">Rejected</a>
    </div>
  </div>

  <% if (transactions.length) { %>
    <div class="table-wrap">
      <table class="data-table">
        <thead><tr><th>ID / Waktu</th><th>User</th><th>Paket</th><th>Nominal</th><th>Status</th><th>Aksi</th></tr></thead>
        <tbody>
          <% transactions.forEach(function (trx) { %>
            <tr>
              <td><code><%= trx.id %></code><small class="table-sub"><%= formatDateTime(trx.createdAt) %></small></td>
              <td><a class="table-user" href="/admin/users?edit=<%= trx.uid %>"><span class="mini-avatar"><%= initials(trx.username) %></span><span><b>@<%= trx.username %></b><small><%= trx.email %></small></span></a></td>
              <td><b><%= trx.planName || trx.planKey %></b><small class="table-sub"><%= trx.type === 'renew' ? 'Perpanjang' : 'Pembelian' %></small></td>
              <td><b><%= formatIDR(trx.amount) %></b></td>
              <td><span class="badge badge-<%= trx.status === 'approved' ? 'green' : (trx.status === 'pending' ? 'amber' : 'red') %>"><%= trx.status %></span><% if (trx.approvedBy) { %><small class="table-sub">oleh <%= trx.approvedBy %></small><% } %></td>
              <td>
                <% if (trx.status === 'pending') { %>
                  <div class="row-actions">
                    <form method="post" action="/admin/transactions/<%= trx.uid %>/<%= trx.id %>/approve" data-confirm="Setujui transaksi <%= trx.id %>? Plan <%= trx.planName %> akan aktif dan kuota ditambahkan.">
                      <input type="hidden" name="_csrf" value="<%= csrf %>">
                      <button class="btn btn-primary btn-xs" type="submit"><i data-lucide="check"></i> Setujui</button>
                    </form>
                    <form method="post" action="/admin/transactions/<%= trx.uid %>/<%= trx.id %>/reject" data-confirm="Tolak transaksi <%= trx.id %>?">
                      <input type="hidden" name="_csrf" value="<%= csrf %>">
                      <button class="btn btn-danger btn-xs" type="submit"><i data-lucide="x"></i> Tolak</button>
                    </form>
                  </div>
                <% } else { %>
                  <span class="muted-text">—</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="empty-state small"><i data-lucide="receipt"></i><h3>Tidak ada transaksi</h3><p>Transaksi baru akan muncul di sini setelah user melakukan order.</p></div>
  <% } %>
</section>

<section class="admin-panel glass-card">
  <div class="panel-head"><div><span class="eyebrow">ALUR</span><h2>Cara kerja persetujuan.</h2></div></div>
  <div class="info-grid">
    <div><i data-lucide="mouse-pointer-click"></i><div><b>1. User order</b><p>User memilih paket dari dashboard. Sistem membuat transaksi pending dan membuka WhatsApp admin.</p></div></div>
    <div><i data-lucide="wallet"></i><div><b>2. Pembayaran</b><p>Admin memverifikasi pembayaran manual. Pastikan nominal dan ID transaksi cocok.</p></div></div>
    <div><i data-lucide="check-check"></i><div><b>3. Setujui</b><p>Klik Setujui. Plan, kuota, dan masa aktif user diperbarui otomatis.</p></div></div>
  </div>
</section>
