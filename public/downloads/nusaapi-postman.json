{
  "info": {
    "_postman_id": "a7b8c9d0-nusa-api-2026",
    "name": "NusaAPI 1.0.0 — Endpoint Collection",
    "description": "Koleksi resmi NusaAPI. Satu API untuk semua project.\n\n1. Duplikat environment atau ubah variabel collection.\n2. Set baseUrl ke URL server kamu.\n3. Set apiKey ke API key dari dashboard, atau gunakan FreeLimit untuk demo.\n\nSemua respons memakai envelope { status, code, message, data, meta }.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "FreeLimit",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "AI",
      "description": "Chat, ringkas, dan analisis sentimen dengan fallback lokal.",
      "item": [
        {
          "name": "AI Chat (GET)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/ai/chat?q=Apa%20itu%20REST%20API%3F",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ai",
                "chat"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "Apa itu REST API?"
                }
              ]
            },
            "description": "Chat dengan model AI dan dapatkan jawaban singkat.\n\nMengirim pertanyaan ke model AI yang dikonfigurasi server. Jika AI_API_KEY belum diisi, endpoint tetap merespons dengan mode demo lokal agar dokumentasi dan integrasi bisa diuji.\n\nPlan minimum: Free. Butuh API key.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{apiKey}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Respons sukses (2xx)\", function () {",
                  "  pm.response.to.be.success;",
                  "});",
                  "pm.test(\"Envelope JSON valid\", function () {",
                  "  pm.expect(pm.response.json()).to.have.property(\"status\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Ringkas Teks (POST)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
