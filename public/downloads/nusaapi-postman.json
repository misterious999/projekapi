              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/ai/summarize?text=REST%20API%20adalah%20gaya%20arsitektur...",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ai",
                "summarize"
              ],
              "query": [
                {
                  "key": "text",
                  "value": "REST API adalah gaya arsitektur..."
                }
              ]
            },
            "description": "Ringkas paragraf panjang menjadi beberapa poin.\n\nMenerima teks dan mengembalikan ringkasan. Bila model AI tersedia, ringkasan dibuat oleh model. Bila tidak, digunakan ringkasan ekstraktif lokal sehingga endpoint tetap berfungsi.\n\nPlan minimum: plus. Butuh API key.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{apiKey}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"REST API adalah gaya arsitektur...\",\n  \"max\": \"3\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Respons sukses (2xx)\", function () {",
                  "  pm.response.to.be.success;",
                  "});",
                  "pm.test(\"Envelope JSON valid\", function () {",
                  "  pm.expect(pm.response.json()).to.have.property(\"status\");",
                  "});"
                ]
              }
            }
          ]
        },
