# =============================================================================
# ZeroixApi — contoh konfigurasi environment
# Salin ke `.env` lalu sesuaikan. Jangan commit `.env` atau service account.
# =============================================================================

# Identitas aplikasi
APP_NAME=ZeroixApi
APP_LEGAL_NAME=ZeroixApi Organizer
APP_TAGLINE=Satu API untuk semua project.
APP_DESCRIPTION=REST API publik dengan dokumentasi lengkap, API key, kuota transparan, monitoring layanan, dan dashboard penggunaan.
APP_URL=http://localhost:3000
APP_VERSION=1.0.0
PORT=3000
NODE_ENV=development

# Firebase Admin SDK
# Simpan file service account di root project sebagai serviceAccountKey.json,
# atau isi FIREBASE_SERVICE_ACCOUNT_JSON dengan isi JSON satu baris.
FIREBASE_SERVICE_ACCOUNT=./serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_WEB_API_KEY=
# Namespace data agar tidak bentrok dengan aplikasi lain di database yang sama.
FIREBASE_DB_ROOT=zeroixapi

# Keamanan & sesi
# Buat dengan: openssl rand -hex 32
SESSION_SECRET=replace-with-64-character-random-secret
KEY_ENCRYPTION_SECRET=replace-with-another-64-character-random-secret
SESSION_DAYS=7
TRUST_PROXY=1

# Admin awal (hanya dibuat saat email belum ada; password tidak pernah ditimpa)
ADMIN_EMAIL=admin@zeroixapi.local
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Administrator
ADMIN_USERNAME=admin

# Kontak & operasional
WA_ADMIN=6281234567890
SUPPORT_EMAIL=support@zeroixapi.local
REGISTRATION_OPEN=true
FREE_LIMIT_DAILY=200
FREE_PLAN_QUOTA=100
REFERRAL_BONUS=150

# AI (opsional). Tanpa key, endpoint AI memakai mode demo lokal.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# OAuth (opsional). Tombol otomatis aktif jika client id & secret diisi.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
